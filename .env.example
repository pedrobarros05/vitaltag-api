# VitalTag — environment variables
# Copy this file to .env and fill in the values

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgres://vitaltag:senha@localhost:5432/vitaltag?sslmode=disable

# ---- Authentication ---------------------------------------------------------
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-de-32-chars

# ---- URLs -------------------------------------------------------------------
# Frontend base URL (used in the URL embedded in the QR Code)
PUBLIC_BASE_URL=http://localhost:3000

# Allowed CORS origin
CORS_ORIGIN=http://localhost:3000

# ---- Server -----------------------------------------------------------------
PORT=8080
