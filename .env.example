# VitalTag — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores

# ---- Banco de dados ---------------------------------------------------------
DATABASE_URL=postgres://vitaltag:senha@localhost:5432/vitaltag?sslmode=disable

# ---- Autenticação -----------------------------------------------------------
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-de-32-chars

# ---- URLs -------------------------------------------------------------------
# URL base do frontend (usada na URL dentro do QR Code)
PUBLIC_BASE_URL=http://localhost:3000

# URL permitida no CORS
CORS_ORIGIN=http://localhost:3000

# ---- Servidor ---------------------------------------------------------------
PORT=8080
